#!/bin/bash

# omarchy:summary=Toggle idle behavior so the system either idles normally or stays awake
# omarchy:group=toggle
# omarchy:args=[toggle|stay-awake|allow-idle|status]
# omarchy:examples=omarchy toggle idle | omarchy toggle idle stay-awake | omarchy-toggle-idle --status

STATE_DIR="$HOME/.local/state/omarchy/indicators"
STATE_FILE="$STATE_DIR/stay-awake"
INHIBIT_PID_FILE="$STATE_DIR/stay-awake.inhibit.pid"

stay_awake_enabled() {
  [[ -f $STATE_FILE ]]
}

# Fork: hypridle (not quickshell) drives the actual lock/screensaver timeouts,
# and already respects `systemd-inhibit --what=idle` out of the box. Holding one
# here is how this toggle reaches hypridle without hypridle needing to know
# anything about omarchy's stay-awake state.
start_inhibitor() {
  if [[ -f $INHIBIT_PID_FILE ]] && kill -0 "$(cat "$INHIBIT_PID_FILE")" 2>/dev/null; then
    return
  fi
  systemd-inhibit --what=idle --who=omarchy --why="Stay awake requested" --mode=block sleep infinity &
  echo $! >"$INHIBIT_PID_FILE"
  disown
}

stop_inhibitor() {
  [[ -f $INHIBIT_PID_FILE ]] && kill "$(cat "$INHIBIT_PID_FILE")" 2>/dev/null
  rm -f "$INHIBIT_PID_FILE"
}

print_status() {
  if stay_awake_enabled; then
    printf '{"enabled":true,"class":"enabled","tooltip":"Allow Idle Lock & Screensaver"}\n'
  else
    printf '{"enabled":false,"class":"disabled","tooltip":"Stay Awake"}\n'
  fi
}

print_idle_state() {
  if stay_awake_enabled; then
    printf 'disabled\n'
  else
    printf 'enabled\n'
  fi
}

# The shell's omarchy.idle service watches STATE_DIR, so touching/removing the
# state file is enough to refresh the bar indicator — the old
# `omarchy-shell -q omarchy.indicators refresh` IPC no longer exists.
apply_state() {
  case "$1" in
    stay-awake)
      mkdir -p "$STATE_DIR"
      touch "$STATE_FILE"
      start_inhibitor
      ;;
    allow-idle)
      rm -f "$STATE_FILE"
      stop_inhibitor
      ;;
  esac
}

case "${1:-toggle}" in
  toggle)
    if stay_awake_enabled; then
      apply_state allow-idle
    else
      apply_state stay-awake
    fi
    print_idle_state
    ;;
  stay-awake|awake|on)
    apply_state stay-awake
    print_idle_state
    ;;
  allow-idle|idle|off)
    apply_state allow-idle
    print_idle_state
    ;;
  status|--status)
    print_status
    ;;
  reconcile)
    # Re-arm the inhibitor hold on shell startup; the systemd-inhibit process
    # itself doesn't survive a reboot/logout even though the state file does.
    if stay_awake_enabled; then start_inhibitor; else stop_inhibitor; fi
    ;;
  *)
    echo "Usage: omarchy-toggle-idle [toggle|stay-awake|allow-idle|status]" >&2
    exit 1
    ;;
esac
