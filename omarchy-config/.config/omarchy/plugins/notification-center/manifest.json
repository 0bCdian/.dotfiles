{
  "schemaVersion": 1,
  "id": "obsy.notification-center",
  "name": "Notification Center",
  "version": "1.0.0",
  "author": "obsy",
  "license": "MIT",
  "description": "Bar bell with unread count, recent-notification list, and DND toggle",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Notification center",
    "description": "Recent notifications + DND",
    "category": "Status",
    "allowMultiple": false,
    "defaults": {
      "limit": 10
    },
    "schema": [
      {
        "key": "limit",
        "type": "integer",
        "label": "Recent notifications shown",
        "min": 1,
        "max": 50,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
